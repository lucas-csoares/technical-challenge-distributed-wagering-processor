# Local development only. These are disposable example credentials.
PORT=3000

# Background workers (SQS consumer, Outbox publisher, PENDING_REFERENCE worker).
# Off by default so that starting the API does not drain the queue unintentionally.
MESSAGING_WORKERS_ENABLED=false

DB_HOST=127.0.0.1
DB_PORT=55432
DB_NAME=wagering
DB_USER=wagering
DB_PASSWORD=local_development_only

# Dedicated test container. Never point these variables at development/production.
TEST_DB_HOST=127.0.0.1
TEST_DB_PORT=55433
TEST_DB_NAME=wagering_test
TEST_DB_USER=wagering_test
TEST_DB_PASSWORD=local_tests_only

# SQS emulado por LocalStack. Credenciais são exigidas pelo SDK e ignoradas
# pelo emulador; nunca aponte estas variáveis para uma conta AWS real.
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=local
AWS_SECRET_ACCESS_KEY=local
SQS_PORT=4566
SQS_ENDPOINT=http://127.0.0.1:4566
WAGER_QUEUE_URL=http://sqs.us-east-1.localhost.localstack.cloud:4566/000000000000/wager-transactions.fifo
WAGER_DLQ_URL=http://sqs.us-east-1.localhost.localstack.cloud:4566/000000000000/wager-transactions-dlq.fifo
EVENTS_QUEUE_URL=http://sqs.us-east-1.localhost.localstack.cloud:4566/000000000000/wager-events.fifo

# Emulador dedicado aos testes, com porta e filas próprias.
TEST_SQS_PORT=4567
TEST_SQS_ENDPOINT=http://127.0.0.1:4567
TEST_WAGER_QUEUE_URL=http://sqs.us-east-1.localhost.localstack.cloud:4567/000000000000/wager-transactions.fifo
TEST_WAGER_DLQ_URL=http://sqs.us-east-1.localhost.localstack.cloud:4567/000000000000/wager-transactions-dlq.fifo
TEST_EVENTS_QUEUE_URL=http://sqs.us-east-1.localhost.localstack.cloud:4567/000000000000/wager-events.fifo
