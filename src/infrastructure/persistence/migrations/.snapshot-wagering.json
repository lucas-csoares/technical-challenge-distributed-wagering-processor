      "checks": [
        {
          "name": "wager_transactions_amount_check",
          "expression": "\nCASE\n    WHEN ((kind)::text = 'LOSS'::text) THEN (amount >= (0)::numeric)\n    ELSE (amount > (0)::numeric)\nEND",
          "definition": "CHECK (\nCASE\n    WHEN ((kind)::text = 'LOSS'::text) THEN (amount >= (0)::numeric)\n    ELSE (amount > (0)::numeric)\nEND)",
          "columnName": "amount"
        },
        {
          "name": "wager_transactions_currency_format_check",
          "expression": "currency ~ '^[A-Z]{3}$'::text",
          "definition": "CHECK ((currency ~ '^[A-Z]{3}$'::text))",
          "columnName": "currency"
        },
        {
          "name": "wager_transactions_external_reference_check",
          "expression": "\nCASE\n    WHEN ((kind)::text = ANY ((ARRAY['REFUND'::character varying, 'ROLLBACK'::character varying])::text[])) THEN (reference_external_transaction_id IS NOT NULL)\n    WHEN ((kind)::text = ANY ((ARRAY['OPENING'::character varying, 'BET'::character varying, 'LOSS'::character varying])::text[])) THEN (reference_external_transaction_id IS NULL)\n    ELSE true\nEND",
          "definition": "CHECK (\nCASE\n    WHEN ((kind)::text = ANY ((ARRAY['REFUND'::character varying, 'ROLLBACK'::character varying])::text[])) THEN (reference_external_transaction_id IS NOT NULL)\n    WHEN ((kind)::text = ANY ((ARRAY['OPENING'::character varying, 'BET'::character varying, 'LOSS'::character varying])::text[])) THEN (reference_external_transaction_id IS NULL)\n    ELSE true\nEND)",
          "columnName": "kind"
        },
        {
          "name": "wager_transactions_failure_code_check",
          "expression": "\nCASE status\n    WHEN 'REJECTED'::text THEN ((failure_code IS NOT NULL) AND ((failure_code)::text = ANY ((ARRAY['INSUFFICIENT_FUNDS'::character varying, 'REVERSAL_WOULD_OVERDRAW'::character varying, 'CURRENCY_MISMATCH'::character varying, 'INVALID_AMOUNT'::character varying, 'REFERENCE_REQUIRED'::character varying, 'REFERENCE_NOT_SUPPORTED'::character varying, 'REFERENCE_KIND_NOT_ELIGIBLE'::character varying, 'REFERENCE_NOT_PROCESSED'::character varying, 'REFERENCE_MISMATCH'::character varying, 'REFERENCE_AMOUNT_MISMATCH'::character varying, 'REFERENCE_ALREADY_REVERSED'::character varying])::text[])))\n    WHEN 'FAILED'::text THEN ((failure_code IS NOT NULL) AND ((failure_code)::text = 'PERMANENT_INFRASTRUCTURE_FAILURE'::text))\n    ELSE (failure_code IS NULL)\nEND",
          "definition": "CHECK (\nCASE status\n    WHEN 'REJECTED'::text THEN ((failure_code IS NOT NULL) AND ((failure_code)::text = ANY ((ARRAY['INSUFFICIENT_FUNDS'::character varying, 'REVERSAL_WOULD_OVERDRAW'::character varying, 'CURRENCY_MISMATCH'::character varying, 'INVALID_AMOUNT'::character varying, 'REFERENCE_REQUIRED'::character varying, 'REFERENCE_NOT_SUPPORTED'::character varying, 'REFERENCE_KIND_NOT_ELIGIBLE'::character varying, 'REFERENCE_NOT_PROCESSED'::character varying, 'REFERENCE_MISMATCH'::character varying, 'REFERENCE_AMOUNT_MISMATCH'::character varying, 'REFERENCE_ALREADY_REVERSED'::character varying])::text[])))\n    WHEN 'FAILED'::text THEN ((failure_code IS NOT NULL) AND ((failure_code)::text = 'PERMANENT_INFRASTRUCTURE_FAILURE'::text))\n    ELSE (failure_code IS NULL)\nEND)",
          "columnName": "failure_code"
        },
        {
          "name": "wager_transactions_internal_identity_check",
          "expression": "((kind = 'OPENING'::text) = (provider_id IS NULL)) AND ((provider_id IS NULL) = (external_transaction_id IS NULL)) AND ((provider_id IS NULL) = (idempotency_key IS NULL)) AND ((provider_id IS NULL) = (payload_hash IS NULL)) AND ((provider_id IS NULL) = (round_id IS NULL)) AND ((provider_id IS NULL) = (game_id IS NULL))",
          "definition": "CHECK (((((kind)::text = 'OPENING'::text) = (provider_id IS NULL)) AND ((provider_id IS NULL) = (external_transaction_id IS NULL)) AND ((provider_id IS NULL) = (idempotency_key IS NULL)) AND ((provider_id IS NULL) = (payload_hash IS NULL)) AND ((provider_id IS NULL) = (round_id IS NULL)) AND ((provider_id IS NULL) = (game_id IS NULL))))",
          "columnName": "external_transaction_id"
        },
        {
          "name": "wager_transactions_internal_reference_check",
          "expression": "(reference_transaction_id IS NOT NULL) = ((status = 'PROCESSED'::text) AND (reference_external_transaction_id IS NOT NULL))",
          "definition": "CHECK (((reference_transaction_id IS NOT NULL) = (((status)::text = 'PROCESSED'::text) AND (reference_external_transaction_id IS NOT NULL))))",
          "columnName": "reference_external_transaction_id"
        },
        {
          "name": "wager_transactions_kind_check",
          "expression": "\"kind\" in ('OPENING', 'BET', 'WIN', 'LOSS', 'REFUND', 'ROLLBACK')",
          "definition": "check (\"kind\" in ('OPENING', 'BET', 'WIN', 'LOSS', 'REFUND', 'ROLLBACK'))",
          "columnName": "kind"
        },
        {
          "name": "wager_transactions_no_self_reference_check",
          "expression": "(reference_transaction_id IS NULL) OR (reference_transaction_id <> id)",
          "definition": "CHECK (((reference_transaction_id IS NULL) OR ((reference_transaction_id)::text <> (id)::text)))",
          "columnName": "id"
        },
        {
          "name": "wager_transactions_pending_reference_check",
          "expression": "(status <> 'PENDING_REFERENCE'::text) OR (kind = ANY (ARRAY['REFUND'::character varying, 'ROLLBACK'::character varying]))",
          "definition": "CHECK ((((status)::text <> 'PENDING_REFERENCE'::text) OR ((kind)::text = ANY ((ARRAY['REFUND'::character varying, 'ROLLBACK'::character varying])::text[]))))",
          "columnName": "kind"
